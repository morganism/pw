# PortableWork — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# ── Server ──────────────────────────────────────────────────────
RACK_ENV=production
PORT=4567

# Generate a strong secret: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── GitHub Sync ──────────────────────────────────────────────────
# Personal Access Token with repo scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USER=

# ── TLS (optional override) ──────────────────────────────────────
# Leave blank to use auto-generated self-signed cert
SSL_KEY=
SSL_CERT=

# ── Database ─────────────────────────────────────────────────────
DATABASE_PATH=/app/db/workspace.db
